# Environment configuration example.
#
# No real secrets belong in this file or in this repository.
# Copy to .env.local locally; .env.local is gitignored.

# AUTH-001: the Laravel backend's own origin. Public (NEXT_PUBLIC_) because
# the browser calls it directly (credentialed fetch, not a server-side
# proxy) — this is API origin configuration, not a secret.
NEXT_PUBLIC_API_URL=http://localhost:8000
