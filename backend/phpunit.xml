<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_DEBUG" value="false"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!--
        TASK-005: real PostgreSQL, not SQLite — PostgreSQL-specific
        behavior (native uuid columns, TIMESTAMPTZ, NUMERIC precision,
        future pg_trgm/JSONB) must be testable against PostgreSQL itself.
        DB_DATABASE is a *distinct* database from backend/.env's
        development DB (healthcare_practice) by name alone, so
        `php artisan test` cannot accidentally target normal development
        data even if backend/.env is misconfigured — these <env> values
        always take precedence during a test run. Dev-only placeholder
        credentials (see docs/development/LOCAL_DEVELOPMENT.md),
        matching scripts/dev-up.sh's automated provisioning.
        -->
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="5432"/>
        <env name="DB_DATABASE" value="healthcare_practice_test"/>
        <env name="DB_USERNAME" value="healthcare"/>
        <env name="DB_PASSWORD" value="healthcare_dev_only"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <!--
        AUTH-001: "database", not "array" — Sanctum's stateful-SPA cookie
        auth is exactly what these tests exercise (login persists a session
        row, logout/password-reset invalidate it), so the test environment
        must use the same session driver as development/production
        (DECISIONS.md ADR-021) to actually prove that behavior rather than
        assume it.
        -->
        <env name="SESSION_DRIVER" value="database"/>
        <env name="SANCTUM_STATEFUL_DOMAINS" value="localhost:3000,127.0.0.1:3000"/>
        <env name="FRONTEND_URL" value="http://localhost:3000"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
